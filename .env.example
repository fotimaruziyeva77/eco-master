# Copy this file to .env and fill in the values. Never commit .env.

# dev | test | prod
ENV=dev

# PostgreSQL (docker-compose.yml exposes it on 127.0.0.1:55440)
DATABASE_URL=postgresql+asyncpg://ekoustoz:ekoustoz@127.0.0.1:55440/ekoustoz

# Telegram bot from @BotFather. Put the token here yourself — do not paste it in chat.
BOT_TOKEN=
# Bot username without @, e.g. ekoustoz_bot
BOT_USERNAME=
# Mini App short name from BotFather (/newapp), used in t.me/<bot>/<app> links
WEBAPP_SHORT_NAME=app
# Public HTTPS URL of the Mini App (Telegram rejects http:// and localhost).
# In development use an ngrok / cloudflared tunnel to the Vite dev server.
WEBAPP_URL=http://localhost:5180

# Session tokens. In prod set a long random value: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=dev-only-change-me

# Allowed browser origins for the API (comma separated)
CORS_ORIGINS=http://localhost:5180

# Dev only: lets the frontend get a signed test initData outside Telegram.
# Ignored unless ENV=dev.
DEV_AUTH=true

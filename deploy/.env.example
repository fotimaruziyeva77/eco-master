# Production settings. Copy to deploy/.env and fill in; never commit deploy/.env.
# Put secrets in here yourself — do not paste them into chats or tickets.

# Domain pointing to this server (DNS A record); HTTPS is set up automatically.
DOMAIN=eco-master.example.uz

# Database password: a long random value, e.g. `openssl rand -base64 32`.
POSTGRES_PASSWORD=

# Telegram bot from @BotFather.
BOT_TOKEN=
# Bot username without @
BOT_USERNAME=eco_master_bot
# Mini App short name from BotFather (/newapp); its URL must be https://DOMAIN
WEBAPP_SHORT_NAME=app

# Session signing key, at least 32 characters:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=

# Private team group that receives what users write to the bot (optional).
FEEDBACK_CHAT_ID=

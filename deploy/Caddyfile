# Eco-Master web server: HTTPS certificates from Let's Encrypt, the API behind /api,
# the Mini App and the admin panel from /srv. DOMAIN comes from deploy/.env.
# Behind the server's own nginx (docker-compose.behind-proxy.yml) DOMAIN is ":80": plain HTTP,
# and nginx does HTTPS.

{
	servers {
		# nginx in front (a private address) passes the visitor's address on; the API needs it
		# for its per-address limits. Visitors from the internet never come from these ranges.
		trusted_proxies static private_ranges
	}
}

{$DOMAIN} {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
		-Server
	}

	# Videos uploaded in the admin panel may be up to 500 MB; every other request stays small,
	# so a huge body can never tie up the API.
	handle /api/admin/media/* {
		request_body {
			max_size 600MB
		}
		reverse_proxy api:8000
	}

	handle /api/* {
		request_body {
			max_size 20MB
		}
		reverse_proxy api:8000
	}

	# Pictures and videos uploaded in the admin panel (deploy/media, read-only here). Only
	# the finished files: tmp/ holds uploads not converted yet. Names are hashes of the files,
	# so browsers may keep them for a year.
	@media path /media/i/* /media/v/*
	handle @media {
		uri strip_prefix /media
		root * /media-files
		header Cache-Control "public, max-age=31536000, immutable"
		file_server
	}

	# Admin panel: never inside a frame, nothing from other sites.
	handle /admin* {
		header Content-Security-Policy "default-src 'self'; img-src 'self' data: https:; style-src 'self' 'unsafe-inline'; font-src 'self'; connect-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'"
		header Cache-Control "no-cache"
		root * /srv
		try_files {path} /admin/index.html
		file_server
	}

	# Mini App. Telegram Web shows it in a frame on web.telegram.org.
	handle {
		@assets path /assets/*
		header @assets Cache-Control "public, max-age=31536000, immutable"
		@pages not path /assets/*
		header @pages Cache-Control "no-cache"
		header Content-Security-Policy "default-src 'self'; script-src 'self' https://telegram.org; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; media-src 'self' https:; font-src 'self'; connect-src 'self'; frame-src https://www.youtube-nocookie.com; frame-ancestors 'self' https://web.telegram.org; base-uri 'self'; form-action 'self'"
		root * /srv
		try_files {path} /index.html
		file_server
	}
}
